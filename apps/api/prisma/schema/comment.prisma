model Comment {
  id         String    @id @default(uuid(7))
  threadId   String
  authorId   String
  parentId   String?
  content    String
  depth      Int       @default(0)
  replyCount Int       @default(0)
  score      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt   DateTime?

  deletedAt         DateTime?
  deletedById       String?
  deletedByPlatform Boolean   @default(false)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  thread          Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author          User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy       User?            @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  commentVotes    CommentVote[]
  reports         ContentReport[]
  platformReports PlatformReport[]

  @@index([threadId, parentId, createdAt, id])
  @@index([threadId, parentId, updatedAt, id])
  @@index([parentId, createdAt, id])
  @@index([parentId, updatedAt, id])
  @@index([authorId, createdAt, id])
  @@index([deletedById])
}

model CommentVote {
  commentId String
  userId    String
  type      VoteType

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}
