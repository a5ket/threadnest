model Nest {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  iconKey     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberCount Int @default(0)
  threadCount Int @default(0)

  deletedAt         DateTime?
  deletedById       String?
  deletedByPlatform Boolean   @default(false)

  members NestMember[]
  threads Thread[]
  bans    NestBan[]

  nestSettings        NestSettings?
  nestJoinRequests    NestJoinRequest[]
  nestInvites         NestInvite[]
  userNestPreferences UserNestPreference[]
  reports             ContentReport[]
  notifications       Notification[]
  actionLogs          NestActionLog[]
  platformReports     PlatformReport[]
  platformActionLogs  PlatformActionLog[]

  deletedBy User? @relation(fields: [deletedById], references: [id], onDelete: SetNull)
}

model NestSettings {
  nestId String @id

  visibility NestVisibility @default(PUBLIC)
  joinPolicy NestJoinPolicy @default(OPEN)

  // Permission thresholds, expressed as a numeric level — see NEST_ACCESS_LEVEL(0 = anyone including non-members)
  minThreadCreationLevel  Int
  minCommentCreationLevel Int

  minThreadVoteLevel  Int
  minCommentVoteLevel Int

  minMemberViewLevel Int

  minNestEditLevel Int

  minThreadLockManageLevel Int
  minThreadPinManageLevel  Int
  minCommentPinManageLevel Int

  minContentModerateLevel Int

  minInviteManageLevel      Int
  minMemberRemoveLevel      Int
  minJoinRequestManageLevel Int
  minBanManageLevel         Int
  minActionLogViewLevel     Int

  nest Nest @relation(fields: [nestId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

enum NestVisibility {
  PUBLIC
  PRIVATE
}

enum NestJoinPolicy {
  OPEN
  BY_REQUEST
  BY_INVITE
}

model NestMember {
  nestId    String
  userId    String
  role      NestMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())

  nest Nest @relation(fields: [nestId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([nestId, userId])
}

enum NestMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

model NestBan {
  id         String        @id @default(uuid(7))
  nestId     String
  userId     String
  bannedById String
  reason     String?
  status     NestBanStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())

  revokedAt   DateTime?
  revokedById String?

  nest      Nest  @relation(fields: [nestId], references: [id], onDelete: Cascade)
  user      User  @relation("NestBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy  User  @relation("NestIssuedBans", fields: [bannedById], references: [id], onDelete: Cascade)
  revokedBy User? @relation("NestRevokedBans", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([nestId, userId], where: { status: "ACTIVE" })
  @@index([nestId, status, createdAt])
  @@index([userId, nestId])
  @@index([bannedById])
}

enum NestBanStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model NestJoinRequest {
  id      String  @id @default(uuid(7))
  nestId  String
  userId  String
  message String?

  status       NestJoinRequestStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())

  nest       Nest  @relation(fields: [nestId], references: [id], onDelete: Cascade)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("NestJoinRequestsReviewer", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([nestId, userId], where: { status: "PENDING" })
  @@index([nestId, userId, status])
  @@index([nestId, status, createdAt])
  @@index([userId, status, createdAt])
}

enum NestJoinRequestStatus {
  CANCELED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model NestInvite {
  id          String  @id @default(uuid(7))
  nestId      String
  userId      String
  invitedById String
  message     String?

  status       NestInviteStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())

  nest       Nest  @relation(fields: [nestId], references: [id], onDelete: Cascade)
  user       User  @relation("NestInvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("NestIssuedInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("NestResolvedInvites", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([nestId, userId], where: { status: "PENDING" })
  @@index([nestId, userId, status])
  @@index([nestId, status, createdAt])
}

enum NestInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model NestActionLog {
  id           String         @id @default(uuid(7))
  nestId       String
  actorId      String
  targetUserId String?
  type         NestActionType
  data         Json
  createdAt    DateTime       @default(now())

  nest   Nest  @relation(fields: [nestId], references: [id], onDelete: Cascade)
  actor  User  @relation("NestActionLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User? @relation("NestActionLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([nestId, createdAt])
  @@index([nestId, type])
}

enum NestActionType {
  MEMBER_ROLE_CHANGED
  MEMBER_BANNED
  MEMBER_UNBANNED
  MEMBER_REMOVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  THREAD_REMOVED
  COMMENT_REMOVED
  REPORT_RESOLVED
  SETTINGS_UPDATED
  OWNERSHIP_TRANSFERRED
}
