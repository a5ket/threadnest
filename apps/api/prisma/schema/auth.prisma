model AuthAccount {
  id                String   @id @default(uuid(7))
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid(7))
  userId            String
  tokenHash         String    @unique
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  userAgent         String?
  ipAddress         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum ConfirmationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ConfirmationTokenStatus {
  PENDING
  REDEEMED
  SUPERSEDED
  EXPIRED
}

model ConfirmationToken {
  id          String                  @id @default(uuid(7))
  userId      String
  tokenHash   String                  @unique
  type        ConfirmationTokenType
  targetEmail String?
  status      ConfirmationTokenStatus @default(PENDING)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([expiresAt])
}
