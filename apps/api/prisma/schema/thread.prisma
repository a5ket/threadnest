model Thread {
  id        String    @id @default(uuid(7))
  nestId    String
  authorId  String
  title     String
  slug      String
  content   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  lockedAt DateTime?
  pinnedAt DateTime?

  deletedAt         DateTime?
  deletedById       String?
  deletedByPlatform Boolean   @default(false)

  commentCount  Int       @default(0)
  lastCommentAt DateTime?
  score         Int       @default(0)

  nest            Nest               @relation(fields: [nestId], references: [id], onDelete: Cascade)
  author          User               @relation(fields: [authorId], references: [id])
  comments        Comment[]
  deletedBy       User?              @relation("ThreadDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  threadVotes     ThreadVote[]
  savedBy         SavedThread[]
  reports         ContentReport[]
  platformReports PlatformReport[]
  attachments     ThreadAttachment[]

  @@unique([nestId, slug])
  @@index([nestId, createdAt])
  @@index([nestId, pinnedAt])
  @@index([nestId, lastCommentAt])
  @@index([authorId, createdAt])
}

model ThreadAttachment {
  id        String   @id @default(uuid(7))
  threadId  String
  key       String
  width     Int
  height    Int
  order     Int
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, order])
}

model ThreadVote {
  threadId String
  userId   String
  type     VoteType

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model SavedThread {
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@index([userId, createdAt])
}
