PORT=3001

DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"

REDIS_HOST="localhost"
REDIS_PORT=6379

WEB_APP_URL="http://localhost:3000"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
